# Optional overrides for local Vite dev / production build (npm run build).
# In Kissflow runtime, app id is read from window.kf when not set here.
# Set these before `npm run zip` when deploying to LIVE if prod ids differ from dev.

# Kissflow tenant (local preview only)
# VITE_KF_BASE_URL=https://development-refexgroup.kissflow.com

# Application id for _application_id= on process / process-report APIs
VITE_KF_APP_ID=Solar_Site_Expense_Governance_Syst_A00

# Process technical names
VITE_KF_ADVANCE_PROCESS_ID=Solar_Advance_Request_YTLA
VITE_KF_REIMBURSEMENT_PROCESS_ID=Technician_Reimbursement__YTLM
VITE_KF_REIMBURSEMENT_APPLICATION_ID=Solar_Site_Expense_Governance_Syst_A00

# All Items report ids (update if prod reports use different names)
VITE_KF_ADVANCE_REPORT_ID=All_Items_A11
VITE_KF_REIMBURSEMENT_REPORT_ID=All_Items_A12

# Optional: force show the + button (debug only)
# VITE_SHOW_CREATE_FAB=true

# Popup ids for row click / FAB
VITE_KF_POPUP_ADVANCE=Popup_6EVNyeI5ca
VITE_KF_POPUP_REIMBURSEMENT=Popup_JOzzdtsOik

# --- LIVE example (uncomment and set before npm run zip if prod differs) ---
# VITE_KF_APP_ID=Solar_Site_Expense_Governance_Syst_A00
# VITE_KF_REIMBURSEMENT_PROCESS_ID=Technician_Reimbursement__YTLM
# VITE_KF_REIMBURSEMENT_REPORT_ID=All_Items_A12
